# Base URL used by the frontend to reach the backend API.
# Also used by vite.config.js to configure the dev server proxy target
# for the /api and /uploads routes.

# Local development (default backend port)
VITE_API_PROXY_TARGET=http://localhost:3000

# Production (Railway) - internal networking address of the backend service
# VITE_API_PROXY_TARGET=http://glowauraskin1.railway.internal:8080
