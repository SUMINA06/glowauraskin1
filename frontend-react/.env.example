# Dev: target backend URL (used by vite dev proxy)
VITE_API_PROXY_TARGET=http://localhost:3000

# Production (Railway): set API_PROXY_TARGET as a runtime env var on the
# frontend service — e.g. API_PROXY_TARGET=http://glowauraskin1.railway.internal:8080
# No VITE_ prefixed vars are needed for the production proxy.
