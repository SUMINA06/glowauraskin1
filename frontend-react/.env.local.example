# Copy this file to .env.local to override local settings for serve.cjs.
# This file is for LOCAL development only — it is NOT committed.

# Backend API target for local run (npm start).
# Defaults to http://localhost:3000 if unset. The local backend
# uses PORT=3000 by default.
# API_PROXY_TARGET=http://localhost:3000

# Port for the frontend server (npm start).
# PORT=4173
